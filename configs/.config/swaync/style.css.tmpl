* {
    font-family: "JetBrainsMono Nerd Font", monospace;
    font-size: 13px;
    border: none;
    border-radius: 0;
    transition: all 0.2s ease;
}

.control-center {
    background: rgba(5, 3, 20, 0.75);
    border-left: 1px solid rgba(0, 210, 255, 0.15);
    box-shadow: -8px 0 32px rgba(0, 0, 0, 0.6);
    padding: 12px 8px;
    margin: 0;
}

.control-center-list {
    background: transparent;
}

.control-center-list-placeholder {
    color: rgba(255, 255, 255, 0.2);
    font-size: 12px;
}

.notification-row {
    margin: 4px 6px;
}

.notification {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 12px;
    margin: 0;
}

.notification:hover {
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(0, 210, 255, 0.25);
}

.notification.critical {
    border-color: rgba(255, 45, 85, 0.5);
    background: rgba(255, 45, 85, 0.08);
}

.summary {
    color: rgba(255, 255, 255, 0.92);
    font-size: 13px;
    font-weight: 700;
}

.time {
    color: rgba(255, 255, 255, 0.3);
    font-size: 10px;
}

.body {
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    margin-top: 4px;
}

.app-icon {
    -gtk-icon-size: 36px;
    margin-right: 10px;
    border-radius: 8px;
}

.app-name {
    color: rgba(0, 210, 255, 0.7);
    font-size: 10px;
    font-weight: 600;
}

.close-button {
    background: transparent;
    color: rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    min-width: 20px;
    min-height: 20px;
    padding: 0;
    font-size: 14px;
}

.close-button:hover {
    background: rgba(255, 45, 85, 0.3);
    color: #ff2d55;
}

.notification-action {
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.7);
    border-radius: 6px;
    margin: 6px 3px 0;
    padding: 5px 12px;
    font-size: 11px;
    border: 1px solid rgba(255, 255, 255, 0.08);
}

.notification-action:hover {
    background: rgba(0, 210, 255, 0.15);
    color: #00d2ff;
    border-color: rgba(0, 210, 255, 0.35);
}

.widget-title {
    color: rgba(255, 255, 255, 0.85);
    font-size: 14px;
    font-weight: 700;
    margin: 4px 8px 8px;
}

.widget-title > button {
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.5);
    border-radius: 8px;
    padding: 4px 10px;
    font-size: 11px;
    border: 1px solid rgba(255, 255, 255, 0.08);
}

.widget-title > button:hover {
    background: rgba(255, 45, 85, 0.2);
    color: #ff2d55;
    border-color: rgba(255, 45, 85, 0.4);
}

.widget-dnd {
    margin: 4px 8px;
    color: rgba(255, 255, 255, 0.7);
}

.widget-dnd > switch {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.widget-dnd > switch:checked {
    background: rgba(0, 210, 255, 0.4);
    border-color: rgba(0, 210, 255, 0.6);
}

.widget-dnd > switch slider {
    background: #ffffff;
    border-radius: 50%;
    min-width: 18px;
    min-height: 18px;
}

.widget-buttons-grid {
    margin: 4px 8px;
}

.widget-buttons-grid > flowbox > flowboxchild > button {
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.6);
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 10px;
    margin: 3px;
}

.widget-buttons-grid > flowbox > flowboxchild > button:hover {
    background: rgba(0, 210, 255, 0.15);
    color: #00d2ff;
    border-color: rgba(0, 210, 255, 0.35);
}

.widget-buttons-grid > flowbox > flowboxchild > button.active {
    background: rgba(0, 210, 255, 0.25);
    color: #00d2ff;
    border-color: rgba(0, 210, 255, 0.5);
}

scale trough {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    min-height: 4px;
}

scale highlight {
    background: rgba(0, 210, 255, 0.6);
    border-radius: 10px;
}

scale slider {
    background: #00d2ff;
    border-radius: 50%;
    min-width: 14px;
    min-height: 14px;
}

.notification-popup {
    background: rgba(5, 3, 20, 0.88);
    border: 1px solid rgba(0, 210, 255, 0.2);
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    margin: 6px;
    padding: 2px;
}

.notification-popup.critical {
    border-color: rgba(255, 45, 85, 0.5);
}

scrollbar {
    background: transparent;
    min-width: 4px;
}

scrollbar slider {
    background: rgba(0, 210, 255, 0.2);
    border-radius: 10px;
    min-height: 30px;
}

scrollbar slider:hover {
    background: rgba(0, 210, 255, 0.4);
}
.widget-mpris {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    padding: 8px;
    margin: 4px 8px;
    border: 1px solid rgba(0, 210, 255, 0.15);
}

.widget-mpris-player {
    padding: 4px;
    color: rgba(255, 255, 255, 0.9);
}

.widget-mpris-title {
    font-weight: 700;
    font-size: 13px;
    color: #ffffff;
}

.widget-mpris-subtitle {
    font-size: 11px;
    color: rgba(0, 210, 255, 0.8);
}
