{
    "layer": "top",
    "position": "bottom",
    "height": 32,
    "spacing": 3,
    "modules-left": [
        "hyprland/workspaces",
        "cpu",
        "memory",
        "temperature",
        "custom/gputemp",
        "custom/updates",
        "custom/osk",
        "custom/lidtoggle"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "backlight",
        "pulseaudio",
        "pulseaudio#microphone",
        "network",
        "bluetooth",
        "battery",
        "privacy",
        "custom/powermode",
        "custom/swaync",
        "custom/power"
    ],
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "true",
        "active-only": true,
        "sort-by-number": true
    },
    "custom/osk": {
        "format": "󰌌",
        "tooltip-format": "Toggle Touch Keyboard",
        "on-click": "qs -p \"$HOME/.config/quickshell/osk.qml\" ipc call osk toggle"
    },
    "cpu": {
        "interval": 2,
        "format": "󰍛 {usage}%",
        "tooltip": false
    },
    "custom/lidtoggle": {
        "return-type": "json",
        "exec": "\"$HOME/.local/bin/lidtoggle\" waybar",
        "interval": 2,
        "on-click": "\"$HOME/.local/bin/lidtoggle\" toggle",
        "tooltip": true
    },
    "tray": {
        "icon-size": 20,
        "spacing": 5
    },
    "privacy": {
        "icon-size": 13,
        "icon-spacing": 5,
        "transition-duration": 250,
        "ignore": [
            {
                "type": "audio-in",
                "name": "cava"
            }
        ],
        "modules": [
            {
                "type": "screenshare",
                "tooltip": true,
                "tooltip-icon-size": 20
            },
            {
                "type": "audio-in",
                "tooltip": true,
                "tooltip-icon-size": 8
            }
        ]
    },
    "memory": {
        "interval": 2,
        "format": "󰘚 {used:0.2f}GB",
        "tooltip-format": "{used:0.1f}GB / {total:0.1f}GB"
    },
    "temperature": {
        "thermal-zone": 0,
        "critical-threshold": 90,
        "interval": 5,
        "format": "󰔏 {temperatureC}°C",
        "format-critical": "󰔐 {temperatureC}°C",
        "tooltip-format": "CPU: {temperatureC}°C"
    },
    "custom/gputemp": {
        "exec": "cat /sys/class/hwmon/hwmon*/temp1_input 2>/dev/null | awk 'NR==3{printf \" %d°C\", $1/1000}' || echo ' N/A'",
        "interval": 5,
        "format": "{}",
        "tooltip-format": "GPU"
    },
    "custom/updates": {
        "exec": "~/.local/bin/yolo-updates",
        "interval": 86400,
        "format": "{}",
        "return-type": "json",
        "on-click": "kitty -e ~/.local/bin/yolo-updates up",
        "tooltip": true,
        "signal": 20
    },
    "clock": {
        "format": "{:%I:%M %p}",
        "format-alt": "{:%A, %B %d %Y}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "xdg-open ~/.config/waybar/calendar.html",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "today": "<span color='#ff2d55'><b>{}</b></span>"
            }
        }
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "pavucontrol",
        "scroll-step": 5
    },
    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "󰍬 {volume}%",
        "format-source-muted": "󰍭",
        "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "scroll-step": 5
    },
    "network": {
        "format-wifi": "{icon} ",
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "format-disconnected": "󰤭",
        "format-ethernet": "󰈀",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "kitty -e nmtui"
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-connected": " {device_alias}",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "on-click": "blueman-manager"
    },
    "battery": {
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "tooltip-format": "{timeTo} · {power}W"
    },
    "custom/powermode": {
        "exec": "~/.local/bin/yolo-power get",
        "interval": 5,
        "return-type": "json",
        "on-click": "~/.local/bin/yolo-power toggle",
        "format": "{}",
        "tooltip": true
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "quickshell -p ~/.config/quickshell/powermenu.qml",
        "tooltip": false
    },
    "custom/swaync": {
        "format": "󰂚 {}",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "return-type": "json",
        "escape": true
    }
}
