# ---- macOS-style battery ----

image {
    monitor =
    path = @YOLO_HOME@/.cache/hyprlock/battery.png

    size = 35
    rounding = 0
    border_size = 0

    position = 35, -20
    halign = right
    valign = top

    reload_time = 2
    reload_cmd = @YOLO_HOME@/.local/bin/hyprlock-battery-image
}

# ---- Clock ----
label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%I:%M")"
    color = @FG@
    font_size = 100
    font_family = Inter Black
    shadow_passes = 3
    shadow_size = 8
    shadow_color = rgba(0, 0, 0, 0.6)

    position = 0, 180
    halign = center
    valign = center
}

# ---- AM/PM ----
label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%p")"
    color = @HIGHLIGHT@
    font_size = 22
    font_family = Inter Black
    shadow_passes = 2
    shadow_color = @HIGHLIGHT_SOFT@

    position = 0, 100
    halign = center
    valign = center
}

# ---- Date ----
label {
    monitor =
    text = cmd[update:60000] echo "$(date +"%A, %B %d")"
    color = @FG_MUTED@
    font_size = 18
    font_family = JetBrains Mono Nerd Font
    shadow_passes = 2
    shadow_color = rgba(0, 0, 0, 0.5)

    position = 0, 55
    halign = center
    valign = center
}

# ---- Divider ----
label {
    monitor =
    text = ──────────────
    color = @ACCENT_SOFT@
    font_size = 12
    font_family = JetBrainsMono Nerd Font

    position = 0, 20
    halign = center
    valign = center
}

# ---- Password Input ----
input-field {
    monitor =
    size = 280, 52
    outline_thickness = 2
    dots_size = 0.28
    dots_spacing = 0.18
    dots_center = true
    dots_rounding = -1

    outer_color = @ACCENT_SOFT@
    inner_color = @BG@
    font_color = @FG@
    fade_on_empty = true
    fade_timeout = 1000
    placeholder_text = Enter Password
    check_color = @SUCCESS@
    fail_color = @WARN@
    fail_text = $FAIL ($ATTEMPTS)
    # fail_transition = 300

    rounding = 12
    shadow_passes = 3
    shadow_size = 6
    shadow_color = @ACCENT_SHADOW@

    position = 0, -30
    halign = center
    valign = center
}

# ---- Unlock hint ----
label {
    monitor =
    text =  Unlock
    color = @FG_FAINT@
    font_size = 11
    font_family = JetBrainsMono Nerd Font

    position = 0, -95
    halign = center
    valign = center
}

# ---- User ----
label {
    monitor =
    text =  $USER
    color = @HIGHLIGHT@
    font_size = 13
    font_family = JetBrainsMono Nerd Font
    shadow_passes = 2
    shadow_color = @HIGHLIGHT_SOFT@

    position = 0, -120
    halign = center
    valign = center
}

# ---- Album artwork ----
image {
    monitor =
    path = ~/.cache/hyprlock/album.png
    size = 120
    rounding = 15
    border_size = 0

    position = 0, 210
    halign = center
    valign = bottom

    reload_time = 2
    reload_cmd = ~/.local/bin/hyprlock-album-art
}

# ---- Music title ----
label {
    monitor =
    text = cmd[update:2000] ~/.local/bin/hyprlock-music title
    color = rgba(ffebf8ee)
    font_size = 18
    font_family = Inter Black

    position = 0, 155
    halign = center
    valign = bottom
}

# ---- Music artist ----
label {
    monitor =
    text = cmd[update:2000] ~/.local/bin/hyprlock-music artist
    color = rgba(ffebf8aa)
    font_size = 13
    font_family = Inter Black

    position = 0, 125
    halign = center
    valign = bottom
}


# ---- Previous ----
label {
    monitor =
    text = cmd[update:1000] ~/.local/bin/hyprlock-music previous
    color = rgba(ffebf8ee)
    font_size = 25
    font_family = JetBrainsMono Nerd Font
    position = -65, 75
    halign = center
    valign = bottom
    onclick = playerctl previous
}

# ---- Play / Pause ----
label {
    monitor =
    text = cmd[update:1000] ~/.local/bin/hyprlock-music status
    color = rgba(ffebf8ee)
    font_size = 25
    font_family = JetBrainsMono Nerd Font
    position = 0, 75
    halign = center
    valign = bottom
    onclick = playerctl play-pause
}

# ---- Next ----
label {
    monitor =
    text = cmd[update:1000] ~/.local/bin/hyprlock-music next
    color = rgba(ffebf8ee)
    font_size = 25
    font_family = JetBrainsMono Nerd Font
    position = 65, 75
    halign = center
    valign = bottom
    onclick = playerctl next
}
