{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "arch",
        "color": {
            "1": "#0db2ff",
            "2": "#ff7166"
        }
    },
    "display": {
        "separator": " ",
        "key": {
            "width": 12
        },
        "color": {
            "keys": "#0db2ff",
            "title": "#1568d1",
            "output": "#ebf9ff",
            "separator": "#1568d1"
        }
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "OS",
            "format": "{name}"
        },
        {
            "type": "host",
            "key": "Host",
            "format": "{family}"
        },
        {
            "type": "kernel",
            "key": "Kernel",
            "format": "{release}"
        },
        {
            "type": "uptime",
            "key": "Uptime",
            "format": "{hours}h {minutes}m"
        },
        {
            "type": "packages",
            "key": "Packages",
            "format": "{all}"
        },
        {
            "type": "shell",
            "key": "Shell",
            "format": "{pretty-name} {version}"
        },
        {
            "type": "display",
            "key": "Display",
            "format": "{width}x{height} @ {refresh-rate}Hz"
        },
        {
            "type": "wm",
            "key": "WM",
            "format": "{pretty-name} {version}"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "format": "{pretty-name} {version}"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "GPU",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "Memory",
            "format": "{used} / {total}"
        },
        {
            "type": "swap",
            "key": "Swap",
            "format": "{used} / {total}"
        },
        {
            "type": "disk",
            "key": "Disk",
            "folders": "/",
            "format": "{size-used} / {size-total}"
        },
        {
            "type": "battery",
            "key": "Battery"
        },
        {
            "type": "localip",
            "key": "IP",
            "format": "{ipv4}"
        },
        "break",
        "colors"
    ]
}