#!/usr/bin/env bash

CACHE="$HOME/.cache/hyprlock"
ART="$CACHE/album.png"
mkdir -p "$CACHE"

URL=$(playerctl metadata mpris:artUrl 2>/dev/null)

if [[ -z "$URL" ]]; then
    exit 0
fi

python - "$URL" "$ART" <<'PY'
import sys, urllib.parse, urllib.request
from pathlib import Path
from PIL import Image
from io import BytesIO

url, output = sys.argv[1:]
parsed = urllib.parse.urlparse(url)

try:
    if parsed.scheme == "file":
        data = Path(urllib.parse.unquote(parsed.path)).read_bytes()
    elif parsed.scheme in ("http", "https"):
        with urllib.request.urlopen(url, timeout=5) as response:
            data = response.read(10 * 1024 * 1024 + 1)
        if len(data) > 10 * 1024 * 1024:
            raise ValueError("Album art exceeds 10 MB")
    else:
        raise ValueError("Unsupported album art URL")

    image = Image.open(BytesIO(data)).convert("RGB")
    image.thumbnail((512, 512))
    image.save(output, "PNG")
except Exception as exc:
    print(f"Album art error: {exc}", file=sys.stderr)
PY

echo "$ART"
