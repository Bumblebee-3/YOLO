#!/usr/bin/env bash
# Present a lightweight still while awww prepares the full animation.
set -eu
wall=${1:?Expected a wallpaper path}
[[ -f $wall ]]
case ${wall,,} in
    *.gif) ;;
    *) exec awww img "$wall" --transition-type none ;;
esac

cache="${XDG_CACHE_HOME:-$HOME/.cache}/wallswitch/previews"
mkdir -p "$cache"
key=$(printf '%s' "$wall" | sha256sum)
preview="$cache/${key%% *}.jpg"
if [[ -s $preview && $wall -ot $preview ]]; then
    awww img "$preview" --filter Bilinear --transition-type none || :
else
    # The last lock-screen still is available immediately while FFmpeg prepares
    # this wallpaper's own first frame in the background.
    fallback="$HOME/.cache/wallpalette/hyprlock-wall.png"
    if [[ -s $fallback ]]; then
        awww img "$fallback" --filter Bilinear --transition-type none || :
    else
        awww restore || :
    fi
    tmp=$(mktemp --suffix=.jpg "$cache/.frame-XXXXXXXX")
    if ffmpeg -nostdin -loglevel error -y -i "$wall" -frames:v 1 \
        -vf "scale='min(1280,iw)':-2" -q:v 3 -update 1 "$tmp"; then
        mv -f -- "$tmp" "$preview"
    else
        rm -f -- "$tmp"
    fi
fi
exec awww img "$wall" --filter Bilinear --transition-type none
