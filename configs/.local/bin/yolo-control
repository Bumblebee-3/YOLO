#!/usr/bin/env bash
set -eu -o pipefail
export LC_ALL=C
control=${1:?}
action=${2:?}
enabled=${SWAYNC_TOGGLE_STATE:-false}
bin=${0%/*}
trap 'notify-send "Control Center" "Could not change $control. Check device availability and permissions." || :' ERR

truth() { if "$@"; then echo true; else echo false; fi; }
case "$control/$action" in
    brightness/get) brightnessctl -c backlight -m | cut -d, -f4 | tr -d '%' ;;
    brightness/set) brightnessctl -q -c backlight set "${3%.*}%" ;;
    gain/get) wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | awk '{printf "%.0f\n", $2 * 100}' ;;
    gain/set) wpctl set-volume @DEFAULT_AUDIO_SOURCE@ "${3}%" ;;
    speaker/*|mic/*)
        device=@DEFAULT_AUDIO_SINK@
        [[ $control != mic ]] || device=@DEFAULT_AUDIO_SOURCE@
        if [[ $action == get ]]; then
            truth grep -q MUTED <<< "$(wpctl get-volume "$device")"
        else
            mute=0
            [[ $enabled != true ]] || mute=1
            wpctl set-mute "$device" "$mute"
        fi ;;
    wifi/*)
        if systemctl is-active --quiet NetworkManager.service; then
            if [[ $action == get ]]; then truth test "$(nmcli radio wifi)" = enabled
            elif [[ $enabled == true ]]; then nmcli radio wifi on
            else nmcli radio wifi off; fi
        elif [[ $action == get ]]; then
            truth grep -qx 'wlan unblocked unblocked' <<< "$(rfkill -rn -o TYPE,SOFT,HARD)"
        elif [[ $enabled == true ]]; then rfkill unblock wlan
        else rfkill block wlan; fi ;;
    airplane/get)
        rfkill -rn -o SOFT | awk '$1 != "blocked" { online=1 } END { print (NR && !online ? "true" : "false") }' ;;
    airplane/set)
        if [[ $enabled == true ]]; then rfkill block all; else rfkill unblock all; fi ;;
    lid/get) truth systemctl --user is-active --quiet lid-inhibit.service ;;
    lid/set)
        if [[ $enabled == true ]]; then "$bin/lidtoggle" on; else "$bin/lidtoggle" off; fi ;;
    power/set) "$bin/yolo-power" toggle && notify-send "Power profile" "$("$bin/yolo-power" get | jq -r '.tooltip // .text')" ;;
    inputs/set|outputs/set|networks/set)
        swaync-client -cp
        case $control in
            inputs) exec pavucontrol -t 4 ;;
            outputs) exec pavucontrol -t 3 ;;
            networks) exec "$bin/yolo-wifi" ;;
        esac ;;
    *) exit 2 ;;
esac
