#!/usr/bin/env bash

SERVICE="lid-inhibit.service"

if [[ "${1:-}" == "waybar" ]]; then
    if systemctl --user is-active --quiet "$SERVICE"; then
        printf '{"text":"󰛨","tooltip":"Lid sleep disabled — laptop stays awake","class":"enabled"}\n'
    else
        printf '{"text":"󰤄","tooltip":"Lid sleep enabled — normal behavior","class":"disabled"}\n'
    fi
    exit 0
fi

case "${1:-toggle}" in
    on)
        systemctl --user start "$SERVICE"
        ;;
    off)
        systemctl --user stop "$SERVICE"
        ;;
    toggle)
        if systemctl --user is-active --quiet "$SERVICE"; then
            systemctl --user stop "$SERVICE"
        else
            systemctl --user start "$SERVICE"
        fi
        ;;
    status)
        ;;
    *)
        echo "Usage: lidtoggle [on|off|toggle|status]"
        exit 1
        ;;
esac

if systemctl --user is-active --quiet "$SERVICE"; then
    echo "Lid sleep: DISABLED (laptop stays awake)"
else
    echo "Lid sleep: ENABLED (normal lid behavior)"
fi
