#!/usr/bin/env bash
# ~/.local/bin/wallswitch   (symlinked as wallswitch-static / wallswitch-animated)

CACHE="$HOME/.cache/wallswitch"
THEME="$HOME/.config/rofi/application-manager.rasi"
BIN="$HOME/.local/bin"
mkdir -p "$CACHE"

case "$(basename "$0")" in

# ── Launcher: ./wallswitch [static|animated] ───────────────────
wallswitch)
    if [[ ${1:-} == --apply ]]; then
        wall=$(<"$CACHE/request")
        [[ -f $wall ]] || exit 1
        dyn="${wall%.*}.dynsky"

        if [[ -f "$dyn/schedule.json" ]]; then
            # Dynamic time-of-day wallpaper
            setsid -f "$BIN/dynsky-run" "$dyn" >/dev/null 2>&1
        else
            # Stop dynamic wallpaper scheduler
            if [[ -s $HOME/.cache/dynsky.pid ]]; then "$BIN/dynsky-run" --stop; fi

            # Apply normal wallpaper
            "$BIN/wall-show" "$wall" || exit 1
        fi

        printf '%s' "$wall" > "$CACHE/last"

        # Dynamic wallpapers manage their own palette updates
        if [[ ! -f "$dyn/schedule.json" ]]; then
            "$BIN/wallpalette" "$wall" || exit 1
        fi

        mkdir -p "$HOME/.cache/wallpalette"
        printf '%s\n' "$wall" > \
            "$HOME/.cache/wallpalette/current_wallpaper"

        LOCK_WALL="$wall"

        case "${wall,,}" in
            *.gif|*.webp|*.apng|*.mp4|*.webm|*.mkv)
                LOCK_WALL="$HOME/.cache/wallpalette/hyprlock-wall.png"
                ffmpeg -y -loglevel error \
                    -i "$wall" -frames:v 1 \
                    "$LOCK_WALL" || exit 1
                ;;
        esac

        WALLPAPER="$LOCK_WALL" \
            "$HOME/.local/bin/theme-hyprlock"

        "$HOME/.local/bin/theme-kitty"
        "$HOME/.local/bin/theme-apps"
        "$HOME/.local/bin/theme-kde"
        "$HOME/.local/bin/theme-sddm" "$wall"
        command -v pywalfox >/dev/null && "$HOME/.local/bin/theme-firefox"

        exit 0
    fi
    GRID='
    window       { width: 66%; height: 76%; }
    entry        { placeholder: "search wallpapers..."; }
    listview     { columns: 4; lines: 3; flow: horizontal; spacing: 8px; padding: 10px; fixed-height: false; }
    element      { orientation: vertical; padding: 10px; spacing: 8px; border: 1px; }
    element-icon { size: 150px; horizontal-align: 0.5; }
    element-text { font: "JetBrains Mono 9"; horizontal-align: 0.5; }
    '
    exec rofi -modes "static:$BIN/wallswitch-static,animated:$BIN/wallswitch-animated" \
        -show "${1:-static}" -show-icons -no-custom -p "wallpaper" \
        -theme "$THEME" -theme-str "$GRID"
    ;;

# ── Script modes (called by rofi) ──────────────────────────────
wallswitch-static|wallswitch-animated)
    if [[ $(basename "$0") == wallswitch-static ]]; then
        DIR="$HOME/oledwall"
        EXT=(-iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp')
    else
        DIR="$HOME/animwall"
        EXT=(-iname '*.gif')
    fi

    if [[ -n ${1:-} ]]; then
        [[ -f ${ROFI_INFO:-} ]] || exit 0
        request=$(mktemp "$CACHE/request.XXXXXXXX") || exit 1
        printf '%s' "$ROFI_INFO" > "$request" && mv -f -- "$request" "$CACHE/request" || exit 1
        exec systemctl --user --no-block restart yolo-wallpaper.service
    fi

    while IFS= read -r -d '' f; do
        hash=$(printf '%s' "$f" | md5sum | cut -d' ' -f1)
        thumb="$CACHE/grid-$hash.png"
        if [[ ! -s $thumb || $f -nt $thumb ]]; then
            preview=$("$BIN/wall-show" "$f" --preview) || preview="$f"
            magick "${preview}[0]" -thumbnail 400x400^ -gravity center -extent 400x400 "$thumb" 2>/dev/null
        fi
        printf '%s\0icon\x1f%s\x1finfo\x1f%s\n' "$(basename "$f")" "$thumb" "$f"
    done < <(find "$DIR" -maxdepth 1 -type f \( "${EXT[@]}" \) -print0 | sort -z)
    ;;
esac
