#!/usr/bin/env bash
# Restore the selected desktop wallpaper once the background layer is ready.
LAST_FILE="$HOME/.cache/wallswitch/last"

last=$(cat "$LAST_FILE" 2>/dev/null)
library="$HOME/.config/yolo/wallpapers"
case "$last" in
    "$HOME"/animwall/*|"$HOME"/oledwall/*)
        migrated="$library/${last#"$HOME"/}"
        [[ ! -f "$migrated" ]] || last=$migrated
        ;;
esac
[[ -f "$last" ]] || last="$library/animwall/nissan.gif"
[[ -f "$last" ]] || last="$library/oledwall/eclipse.jpg"

# Paint a lightweight layer before starting the animation daemon. The bundled
# still also covers the first login, when the preview cache is empty.
still=/usr/share/sddm/themes/yolo/Backgrounds/login-preview.jpg
[[ -s $still ]] || still="$HOME/.local/share/yolo/login-wall.jpg"
swaybg -m fill -i "$still" &
still_pid=$!
if ! awww query >/dev/null 2>&1; then
    awww-daemon --no-cache &
fi
# The IPC socket can answer before Wayland has configured an output.
# Wait for an actual output and retry the first image submission.
ready=false
for ((attempt=0; attempt<200; attempt++)); do
    if [[ -n $(awww query 2>/dev/null) ]] &&
        awww img "$still" --filter Bilinear --transition-type none; then
        ready=true
        break
    fi
    sleep 0.1
done
if [[ $ready != true ]]; then
    printf 'wall-boot: awww could not display the preview; trying the selected wallpaper directly\n' >&2
    "$HOME/.local/bin/wall-show" "$last" || exit 1
fi
[[ -f "$last" ]] || exit 0
# Use the same cancellable worker as the picker. A subsequent selection
# replaces the entire restore job, including palette and application updates.
mkdir -p "${LAST_FILE%/*}"
request=$(mktemp "${LAST_FILE%/*}/request.XXXXXXXX") || exit 1
printf '%s' "$last" > "$request" && mv -f -- "$request" "${LAST_FILE%/*}/request" || exit 1
systemctl --user import-environment WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE
# Keep the higher swaybg layer through GIF decoding and the final submission.
# Any successful picker selection can also complete a failed startup handoff.
pending="$XDG_RUNTIME_DIR/yolo-wall-start-$HYPRLAND_INSTANCE_SIGNATURE"
mkdir -p "$pending" || exit 1
systemctl --user --no-block restart yolo-wallpaper.service
while [[ -d $pending ]] && kill -0 "$still_pid" 2>/dev/null; do
    sleep 0.2
done
kill "$still_pid" 2>/dev/null || :
