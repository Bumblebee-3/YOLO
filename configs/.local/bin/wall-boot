#!/bin/bash
# Show a static wallpaper instantly at login, then fade to the real (slow-to-load) one.
#
#   STATIC    = the still image you already made for hyprlock  <-- set this
#   LAST_FILE = written by wallswitch every time you pick a wallpaper

STATIC="$HOME/.cache/wallpalette/hyprlock-wall.png"
LAST_FILE="$HOME/.cache/wallswitch/last"

# wait (max ~10 s) for awww-daemon to accept commands
for _ in $(seq 1 100); do
    awww query >/dev/null 2>&1 && break
    sleep 0.1
done

last=$(cat "$LAST_FILE" 2>/dev/null)
[[ -f "$last" ]] || last="$HOME/animwall/nissan.gif"

# 1. instant placeholder (only worth it if the real wallpaper is a different, heavier file)
if [ -f "$STATIC" ] && [ "$last" != "$STATIC" ]; then
    awww img "$STATIC" --transition-type none
fi

# 2. the real wallpaper: the daemon decodes it in the background and swaps it in with a fade

if [ -n "$last" ] && [ -f "$last" ]; then
    dyn="${last%.*}.dynsky"

    if [ -f "$dyn/schedule.json" ]; then
        # Restart the dynamic wallpaper scheduler
        setsid -f "$HOME/.local/bin/dynsky-run" "$dyn" >/dev/null 2>&1
    else
        # Restore normal wallpaper
        sleep 0.5
        awww img "$last" \
            --transition-type fade \
            --transition-duration 1.5
    fi
fi

# Populate first-login assets expected by the lock screen and QuickShell.
if [[ -f "$last" && ! -s "$STATIC" ]]; then
    mkdir -p "${STATIC%/*}"
    if ffmpeg -nostdin -loglevel error -y -i "$last" -frames:v 1 "$STATIC"; then
        "$HOME/.local/bin/wallpalette" "$last" &&
            WALLPAPER="$STATIC" "$HOME/.local/bin/theme-hyprlock"
    fi
fi
