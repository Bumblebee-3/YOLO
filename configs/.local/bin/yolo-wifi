#!/usr/bin/env bash
# NetworkManager can use iwd as its own backend; prefer its UI in that case.
if systemctl is-active --quiet NetworkManager.service; then
    exec kitty --class yolo-wifi --title "Wi-Fi Manager" -e nmtui
fi
if systemctl is-active --quiet iwd.service; then
    if command -v iwgtk >/dev/null; then
        exec iwgtk
    fi
    exec kitty --class yolo-wifi --title "Wi-Fi Manager" -e iwctl
fi
exec notify-send "Wi-Fi" "Neither iwd nor NetworkManager is running."
