#!/usr/bin/env python3
import json
import colorsys
import subprocess
from pathlib import Path

home = Path.home()
pal = json.loads(
    (home / ".cache/wallpalette/colors.json").read_text()
)

def rgb(color):
    color = color.lstrip("#")
    return tuple(int(color[i:i+2], 16) / 255 for i in (0, 2, 4))

def hexc(r, g, b):
    return "#{:02x}{:02x}{:02x}".format(
        round(r * 255), round(g * 255), round(b * 255)
    )

def hsv_color(color, saturation, value):
    h, _, _ = colorsys.rgb_to_hsv(*rgb(color))
    return hexc(*colorsys.hsv_to_rgb(h, saturation, value))

def mix(a, b, t):
    x, y = rgb(a), rgb(b)
    return hexc(*(x[i] * (1-t) + y[i] * t for i in range(3)))

fg = pal["fg"]
accent = pal["accent"]
accent2 = pal["accent2"]
highlight = pal["highlight"]
warn = pal["warn"]

# Dark background tinted toward the wallpaper hue
bg = hsv_color(accent, 0.55, 0.075)
bg_light = mix(bg, accent, 0.12)

colors = {
    "foreground": fg,
    "background": bg,
    "cursor": accent,
    "cursor_text_color": bg,
    "selection_foreground": fg,
    "selection_background": bg_light,
    "url_color": highlight,

    "active_border_color": accent,
    "inactive_border_color": accent2,
    "bell_border_color": highlight,

    "active_tab_foreground": bg,
    "active_tab_background": accent,
    "inactive_tab_foreground": fg,
    "inactive_tab_background": bg_light,

    # ANSI normal colors
    "color0": bg_light,
    "color1": accent2,
    "color2": warn,
    "color3": highlight,
    "color4": accent,
    "color5": accent2,
    "color6": highlight,
    "color7": mix(fg, bg, 0.25),

    # ANSI bright colors
    "color8": mix(fg, bg, 0.50),
    "color9": mix(accent2, fg, 0.30),
    "color10": mix(warn, fg, 0.20),
    "color11": mix(highlight, fg, 0.25),
    "color12": mix(accent, fg, 0.25),
    "color13": mix(accent2, fg, 0.40),
    "color14": mix(highlight, fg, 0.40),
    "color15": fg,
}

config = home / ".config/kitty/wallpalette.conf"
config.parent.mkdir(parents=True, exist_ok=True)

config.write_text(
    "# Generated by theme-kitty. Do not edit.\n" +
    "".join(f"{k} {v}\n" for k, v in colors.items())
)

# Update all running Kitty instances that have listening sockets.
for socket in Path("/tmp").glob("kitty-*"):
    if not socket.is_socket():
        continue
    subprocess.run(
        [
            "kitten", "@",
            "--to", f"unix:{socket}",
            "set-colors",
            "--all",
            "--configured",
            str(config)
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=3
    )

print(f"Kitty theme generated: {config}")
