#!/usr/bin/env bash

case "$1" in
    title)
        playerctl status 2>/dev/null | grep -Eq '^(Playing|Paused)$' || exit 0
        playerctl metadata --format '{{title}}' 2>/dev/null | cut -c1-50
        ;;
    artist)
        playerctl status 2>/dev/null | grep -Eq '^(Playing|Paused)$' || exit 0
        playerctl metadata --format '{{artist}}' 2>/dev/null | cut -c1-50
        ;;
    status)
    case "$(playerctl status 2>/dev/null)" in
        Playing) echo "󰏤" ;;
        Paused)  echo "󰐊" ;;
        *)       ;;
    esac
    ;;
    previous)
        playerctl status 2>/dev/null | grep -Eq '^(Playing|Paused)$' && echo "󰒮"
        ;;
    next)
        playerctl status 2>/dev/null | grep -Eq '^(Playing|Paused)$' && echo "󰒭"
        ;;
esac
